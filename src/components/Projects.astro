---
import projects from '../data/projects.json';

const categories = ['Semua', 'Web App', 'IoT', 'Productivity', 'Dashboard'];
---

<section id="projects" class="relative py-32">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <p class="text-indigo-400 font-medium tracking-widest uppercase text-sm mb-4">Portofolio</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-4">
        <span class="gradient-text">Proyek Unggulan</span>
      </h2>
      <p class="text-white/50 max-w-2xl mx-auto">Karya terbaik yang menggabungkan keahlian industri dan teknologi modern.</p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      {categories.map((cat, i) => (
        <button 
          class={`filter-btn px-6 py-2.5 rounded-xl text-sm font-medium transition-all duration-300 ${i === 0 ? 'gradient-bg text-white' : 'glass text-white/60 hover:text-white hover:bg-white/10'}`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.projects.map((project, index) => (
        <article 
          class={`glass-strong rounded-3xl overflow-hidden group hover-lift border border-white/5 project-card reveal`}
          data-category={project.category}
          style={`--reveal-delay: ${index * 0.15}s`}
        >
          <!-- Project Image -->
          <div class="relative overflow-hidden aspect-video">
            <div class={`absolute inset-0 bg-gradient-to-br ${project.accent}20 to-transparent`}></div>
            <img 
              src={project.image} 
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            {project.featured && (
              <div class="absolute top-4 right-4 px-3 py-1 rounded-full glass-strong text-xs font-medium">
                ⭐ Featured
              </div>
            )}
          </div>

          <!-- Project Content -->
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs px-3 py-1 rounded-full bg-white/5 text-white/50">{project.category}</span>
              <a 
                href={project.github}
                target="_blank"
                class="text-white/40 hover:text-white transition-colors"
                aria-label={`View ${project.title} on GitHub`}
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            </div>

            <h3 class="font-display text-xl font-semibold mb-2 group-hover:text-indigo-300 transition-colors">
              {project.title}
            </h3>
            <p class="text-white/50 text-sm leading-relaxed mb-4 line-clamp-3">
              {project.description}
            </p>

            <!-- Tech Stack -->
            <div class="flex flex-wrap gap-2">
              {project.tech.map(tech => (
                <span class="text-xs px-2.5 py-1 rounded-lg bg-white/5 text-white/50 font-mono">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- View All Projects -->
    <div class="text-center mt-16 reveal">
      <a 
        href="https://github.com/bayz-dik" 
        target="_blank"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl glass-strong hover:bg-white/10 transition-all duration-300 border border-white/10 group"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>Lihat Semua Proyek di GitHub</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button
      filterBtns.forEach(b => {
        b.classList.remove('gradient-bg', 'text-white');
        b.classList.add('glass', 'text-white/60');
      });
      btn.classList.add('gradient-bg', 'text-white');
      btn.classList.remove('glass', 'text-white/60');

      const category = btn.dataset.category;
      
      projectCards.forEach(card => {
        const cardCategory = card.dataset.category;
        const shouldShow = category === 'Semua' || cardCategory === category;
        
        if (shouldShow) {
          card.style.display = 'block';
          card.style.animation = 'fadeIn 0.5s ease';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Add fadeIn keyframe
  const style = document.createElement('style');
  style.textContent = `
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
  `;
  document.head.appendChild(style);
</script>

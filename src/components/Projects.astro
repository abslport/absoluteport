---
import { projects } from '../data/projects';

const categories = ['Semua', 'Manufacturing', 'Retail', 'Otomotif', 'Web', 'Management'];
---

<section id="projects" class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="glass px-4 py-2 text-sm text-primary-light mb-4 inline-block">Proyek Saya</span>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
        Karya <span class="gradient-text">Terbaik Saya</span>
      </h2>
      <p class="text-slate-400 max-w-2xl mx-auto">Kumpulan proyek yang saya kerjakan, mencerminkan dedikasi dan keterampilan saya.</p>
    </div>

    <!-- Filter buttons -->
    <div id="filters" class="flex flex-wrap justify-center gap-3 mb-12">
      {categories.map(cat => (
        <button
          data-filter={cat}
          class="filter-btn glass px-4 py-2 text-sm text-slate-300 hover:text-white transition-all hover:border-primary/50"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Projects grid -->
    <div id="projects-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <article
          class="project-card glass-dark p-6 card-hover group relative overflow-hidden"
          data-categories={project.category.join(',')}
        >
          <!-- Featured badge -->
          {project.featured && (
            <span class="absolute top-4 right-4 bg-gradient-to-r from-primary to-accent px-3 py-1 rounded-full text-xs font-semibold z-10">
              ⭐ Featured
            </span>
          )}

          <!-- Project image placeholder -->
          <div class="w-full h-40 rounded-xl bg-gradient-to-br from-primary/30 to-accent/30 flex items-center justify-center mb-5 overflow-hidden group-hover:scale-105 transition-transform duration-500">
            <div class="text-6xl opacity-60 group-hover:opacity-100 transition-opacity">🚀</div>
          </div>

          <h3 class="font-display font-semibold text-xl mb-2 group-hover:text-primary-light transition-colors">
            {project.title}
          </h3>

          <p class="text-slate-400 text-sm leading-relaxed mb-4 line-clamp-3">
            {project.description}
          </p>

          <!-- Tech tags -->
          <div class="flex flex-wrap gap-2 mb-4">
            {project.tech.map(tech => (
              <span class="text-xs px-2 py-1 rounded-lg bg-primary/10 text-primary-light">{tech}</span>
            ))}
          </div>

          <!-- Links -->
          <div class="flex items-center gap-3 mt-auto">
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-slate-300 hover:text-white flex items-center gap-1 group-hover:gap-2 transition-all"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              GitHub
            </a>
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-slate-300 hover:text-white flex items-center gap-1 transition-all"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Demo
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Project filtering
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');
  
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button style
      filterBtns.forEach(b => b.classList.remove('border-primary', 'text-white'));
      btn.classList.add('border-primary', 'text-white');
      
      const filter = btn.dataset.filter;
      
      projectCards.forEach(card => {
        const categories = card.dataset.categories.split(',');
        const shouldShow = filter === 'Semua' || categories.includes(filter);
        
        if (shouldShow) {
          card.style.display = 'block';
          card.style.animation = 'fadeIn 0.5s ease forwards';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 grid-pattern opacity-50"></div>
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-indigo-600/20 blur-3xl animate-blob"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-pink-600/20 blur-3xl animate-blob" style="animation-delay: 3s"></div>
  <div class="absolute top-1/3 left-1/2 w-64 h-64 rounded-full bg-cyan-500/20 blur-3xl animate-blob" style="animation-delay: 6s"></div>

  <!-- Floating 3D shapes -->
  <div class="absolute top-20 left-[10%] w-20 h-20 border-2 border-indigo-400/30 rotate-45 animate-float hidden lg:block"></div>
  <div class="absolute bottom-32 right-[12%] w-16 h-16 border-2 border-pink-400/30 rounded-full animate-float hidden lg:block" style="animation-delay: 2s"></div>
  <div class="absolute top-1/2 left-[5%] w-12 h-12 border-2 border-cyan-400/30 rounded-lg animate-float hidden lg:block" style="animation-delay: 4s"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 text-center">
    <!-- Status badge -->
    <div class="inline-flex items-center gap-2 glass-strong rounded-full px-4 py-2 mb-8 hero-reveal">
      <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      <span class="text-xs text-white/60 tracking-wider">Tersedia untuk proyek baru</span>
    </div>

    <!-- Name -->
    <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold mb-6 hero-reveal" style="--reveal-delay: 0.2s">
      <span class="gradient-text">Bayu Andika</span>
    </h1>

    <!-- Profession with typing effect -->
    <p class="text-xl md:text-3xl text-white/80 font-light mb-8 hero-reveal" style="--reveal-delay: 0.4s">
      <span id="typing-text" class="font-medium"></span><span class="typing-cursor text-indigo-400">|</span>
    </p>

    <!-- Description -->
    <p class="max-w-2xl mx-auto text-white/50 text-base md:text-lg mb-12 hero-reveal" style="--reveal-delay: 0.6s">
      Menggabungkan presisi operasional, keahlian layanan pelanggan, dan ketekunan dunia manufaktur dalam setiap karya digital.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 hero-reveal" style="--reveal-delay: 0.8s">
      <a 
        href="#projects"
        class="group px-8 py-4 rounded-2xl gradient-bg font-medium hover:scale-105 active:scale-95 transition-all duration-300 glow-indigo"
        data-hover
      >
        Lihat Proyek Saya
        <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
      </a>
      <a 
        href="#contact"
        class="px-8 py-4 rounded-2xl glass-strong font-medium hover:bg-white/10 transition-all duration-300 border border-white/10"
        data-hover
      >
        Hubungi Saya
      </a>
    </div>

    <!-- Social Icons -->
    <div class="flex items-center justify-center gap-6 hero-reveal" style="--reveal-delay: 1s">
      <a href="https://github.com/bayz-dik" target="_blank" class="w-12 h-12 rounded-xl glass flex items-center justify-center hover:scale-110 hover:bg-white/10 transition-all duration-300" data-hover>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://instagram.com/bayydka" target="_blank" class="w-12 h-12 rounded-xl glass flex items-center justify-center hover:scale-110 hover:bg-white/10 transition-all duration-300" data-hover>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
      <a href="https://facebook.com" target="_blank" class="w-12 h-12 rounded-xl glass flex items-center justify-center hover:scale-110 hover:bg-white/10 transition-all duration-300" data-hover>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
      </a>
      <a href="mailto:bayuandk4@gmail.com" class="w-12 h-12 rounded-xl glass flex items-center justify-center hover:scale-110 hover:bg-white/10 transition-all duration-300" data-hover>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l10 8.104 10-8.104v11.817h-20z"/></svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<script>
  // Typing effect
  const professions = [
    'Store Operation Specialist',
    'Service Advisor',
    'Stamping Press Operator',
    'Full-Stack Developer'
  ];
  
  const typingEl = document.getElementById('typing-text');
  let professionIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function type() {
    const current = professions[professionIndex];
    
    if (isDeleting) {
      charIndex--;
    } else {
      charIndex++;
    }

    typingEl.textContent = current.substring(0, charIndex);

    let delay = isDeleting ? 50 : 100;

    if (!isDeleting && charIndex === current.length) {
      delay = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      professionIndex = (professionIndex + 1) % professions.length;
      delay = 500;
    }

    setTimeout(type, delay);
  }

  type();

  // Hero reveal animations with GSAP
  document.addEventListener('DOMContentLoaded', () => {
    const reveals = document.querySelectorAll('.hero-reveal');
    reveals.forEach((el, i) => {
      const delay = parseFloat(el.style.getPropertyValue('--reveal-delay')) || 0;
      el.style.opacity = '0';
      el.style.transform = 'translateY(40px)';
      
      setTimeout(() => {
        el.style.transition = 'opacity 1s ease, transform 1s cubic-bezier(0.34, 1.56, 0.64, 1)';
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      }, delay * 1000);
    });
  });
</script>

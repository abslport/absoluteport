---
const contactInfo = [
  {
    label: 'Email',
    value: 'bayuandk4@gmail.com',
    href: 'mailto:bayuandk4@gmail.com',
    icon: 'email',
    color: 'indigo'
  },
  {
    label: 'WhatsApp',
    value: '087881820662',
    href: 'https://wa.me/6287881820662',
    icon: 'phone',
    color: 'green'
  },
  {
    label: 'Instagram',
    value: '@bayydka',
    href: 'https://instagram.com/bayydka',
    icon: 'instagram',
    color: 'pink'
  },
  {
    label: 'GitHub',
    value: '@bayz-dik',
    href: 'https://github.com/bayz-dik',
    icon: 'github',
    color: 'gray'
  }
];
---

<section id="contact" class="relative py-32 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 grid-pattern opacity-30"></div>
  <div class="absolute -bottom-32 left-1/2 transform -translate-x-1/2 w-[600px] h-[600px] rounded-full gradient-bg blur-3xl opacity-10"></div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <p class="text-indigo-400 font-medium tracking-widest uppercase text-sm mb-4">Kontak</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-4">
        <span class="gradient-text">Mari Berkolaborasi</span>
      </h2>
      <p class="text-white/50 max-w-2xl mx-auto">Punya proyek atau butuh bantuan? Jangan ragu untuk menghubungi saya.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Info Cards -->
      <div class="space-y-6">
        {contactInfo.map((info, index) => (
          <a 
            href={info.href}
            target={info.href.startsWith('http') ? '_blank' : undefined}
            class="flex items-center gap-4 glass-strong rounded-2xl p-6 hover-lift border border-white/5 group reveal"
            style={`--reveal-delay: ${index * 0.1}s`}
            data-hover
          >
            <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${
              info.color === 'indigo' ? 'from-indigo-500 to-indigo-600' :
              info.color === 'green' ? 'from-green-500 to-emerald-600' :
              info.color === 'pink' ? 'from-pink-500 to-rose-600' :
              'from-gray-600 to-gray-700'
            } flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300`}>
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {info.icon === 'email' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>}
                {info.icon === 'phone' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>}
                {info.icon === 'instagram' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 3h-4a8 8 0 00-8 8v4a8 8 0 008 8h4a8 8 0 008-8v-4a8 8 0 00-8-8zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-9-5a1 1 0 100 2 1 1 0 000-2z"/>}
                {info.icon === 'github' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>}
              </svg>
            </div>
            <div>
              <p class="text-white/50 text-sm mb-1">{info.label}</p>
              <p class="font-medium group-hover:text-indigo-300 transition-colors">{info.value}</p>
            </div>
            <svg class="w-5 h-5 ml-auto text-white/30 group-hover:text-white/70 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        ))}
      </div>

      <!-- Contact Form -->
      <div class="glass-strong rounded-3xl p-8 reveal">
        <h3 class="font-display text-2xl font-semibold mb-6">Kirim Pesan</h3>
        <form id="contact-form" class="space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm text-white/60 mb-2">Nama</label>
              <input 
                type="text" 
                id="name"
                required
                placeholder="Nama lengkap"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder-white/20"
              />
            </div>
            <div>
              <label for="email" class="block text-sm text-white/60 mb-2">Email</label>
              <input 
                type="email" 
                id="email"
                required
                placeholder="email@example.com"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder-white/20"
              />
            </div>
          </div>
          <div>
            <label for="subject" class="block text-sm text-white/60 mb-2">Subjek</label>
            <input 
              type="text" 
              id="subject"
              required
              placeholder="Apa yang bisa saya bantu?"
              class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder-white/20"
            />
          </div>
          <div>
            <label for="message" class="block text-sm text-white/60 mb-2">Pesan</label>
            <textarea 
              id="message"
              required
              rows="6"
              placeholder="Tulis pesan Anda di sini..."
              class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder-white/20 resize-none"
            ></textarea>
          </div>
          <button 
            type="submit"
            class="w-full py-4 rounded-2xl gradient-bg font-medium hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 glow-indigo"
          >
            Kirim Pesan
            <span class="inline-block ml-2">→</span>
          </button>
          <p id="form-status" class="hidden text-center text-sm py-3 rounded-xl"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const name = document.getElementById('name').value;
    const email = document.getElementById('email').value;
    const subject = document.getElementById('subject').value;
    const message = document.getElementById('message').value;

    // Build mailto link
    const body = `Nama: ${name}\nEmail: ${email}\n\n${message}`;
    const mailtoUrl = `mailto:bayuandk4@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    window.location.href = mailtoUrl;

    // Show success
    status.textContent = '✓ Terima kasih! Email client akan terbuka untuk mengirim pesan.';
    status.classList.remove('hidden');
    status.classList.add('bg-green-500/10', 'text-green-400');
    form.reset();
  });
</script>

---
// Contact section dengan form & social links
---

<section id="contact" class="py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="section-title" data-reveal>Hubungi Saya</h2>

    <div class="grid md:grid-cols-2 gap-10">
      <!-- Contact info -->
      <div data-reveal class="space-y-6">
        <div class="glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span class="text-2xl">📧</span> Email
          </h3>
          <a href="mailto:bayuandk4@gmail.com" class="text-primary hover:underline break-all">
            bayuandk4@gmail.com
          </a>
        </div>

        <div class="glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span class="text-2xl">📱</span> Telepon
          </h3>
          <a href="tel:087881820662" class="text-primary hover:underline">
            0878-8182-0662
          </a>
        </div>

        <div class="glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span class="text-2xl">🌐</span> Sosial Media
          </h3>
          <div class="flex gap-3 flex-wrap">
            <a href="https://instagram.com/bayydka" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-r from-pink-500 to-orange-400 text-white text-sm font-medium hover:opacity-90 transition-all transform hover:scale-105">
              <span>📷</span> Instagram
            </a>
            <a href="https://facebook.com/Bayz" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-r from-blue-600 to-blue-400 text-white text-sm font-medium hover:opacity-90 transition-all transform hover:scale-105">
              <span>📘</span> Facebook
            </a>
            <a href="https://github.com/bayz-dik" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-r from-gray-700 to-gray-500 text-white text-sm font-medium hover:opacity-90 transition-all transform hover:scale-105">
              <span>🐙</span> GitHub
            </a>
          </div>
        </div>

        <div class="glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span class="text-2xl">📍</span> Lokasi
          </h3>
          <p class="text-gray-600 dark:text-gray-300">
            Indonesia
          </p>
        </div>
      </div>

      <!-- Contact form -->
      <div data-reveal-delay="200">
        <form id="contact-form" class="glass-card rounded-2xl p-8 space-y-6">
          <h3 class="text-2xl font-bold">Kirim Pesan</h3>
          
          <div>
            <label for="name" class="block text-sm font-medium mb-2">Nama</label>
            <input type="text" id="name" name="name" required
              class="w-full px-4 py-3 rounded-lg bg-white/50 dark:bg-white/10 border border-white/20 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
              placeholder="Nama Anda" />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium mb-2">Email</label>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-3 rounded-lg bg-white/50 dark:bg-white/10 border border-white/20 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
              placeholder="email@example.com" />
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium mb-2">Subjek</label>
            <input type="text" id="subject" name="subject" required
              class="w-full px-4 py-3 rounded-lg bg-white/50 dark:bg-white/10 border border-white/20 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
              placeholder="Subjek pesan" />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium mb-2">Pesan</label>
            <textarea id="message" name="message" rows="4" required
              class="w-full px-4 py-3 rounded-lg bg-white/50 dark:bg-white/10 border border-white/20 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all resize-none"
              placeholder="Tulis pesan Anda..."></textarea>
          </div>

          <button type="submit"
            class="w-full py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold hover:opacity-90 transition-all transform hover:scale-[1.02] shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2">
            <span>📤</span> Kirim Pesan
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Form handling - will open mailto as fallback
  const form = document.getElementById('contact-form');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const name = formData.get('name');
    const email = formData.get('email');
    const subject = formData.get('subject');
    const message = formData.get('message');

    const mailtoLink = `mailto:bayuandk4@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(`Nama: ${name}\nEmail: ${email}\n\n${message}`)}`;
    window.location.href = mailtoLink;

    // Show success feedback
    const button = form.querySelector('button');
    button.innerHTML = '<span>✅</span> Pesan siap dikirim!';
    button.classList.add('from-green-500', 'to-emerald-500');
    setTimeout(() => {
      button.innerHTML = '<span>📤</span> Kirim Pesan';
      button.classList.remove('from-green-500', 'to-emerald-500');
      form.reset();
    }, 3000);
  });
</script>

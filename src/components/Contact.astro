---
const contactInfo = [
  { icon: '📧', label: 'Email', value: 'bayuandk4@gmail.com', href: 'mailto:bayuandk4@gmail.com' },
  { icon: '📱', label: 'WhatsApp', value: '087881820662', href: 'https://wa.me/6287881820662' },
  { icon: '📸', label: 'Instagram', value: '@bayydka', href: 'https://instagram.com/bayydka' },
  { icon: '👤', label: 'Facebook', value: 'Bayz', href: '#' },
  { icon: '💻', label: 'GitHub', value: 'bayz-dik', href: 'https://github.com/bayz-dik' },
];
---

<section id="contact" class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="glass px-4 py-2 text-sm text-primary-light mb-4 inline-block">Kontak</span>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
        Mari <span class="gradient-text">Terhubung</span>
      </h2>
      <p class="text-slate-400 max-w-2xl mx-auto">Punya pertanyaan atau ingin bekerja sama? Jangan ragu untuk menghubungi saya!</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Contact info cards -->
      <div class="space-y-4">
        {contactInfo.map(info => (
          <a
            href={info.href}
            target="_blank"
            rel="noopener noreferrer"
            class="glass-dark p-5 flex items-center gap-4 card-hover group"
          >
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
              {info.icon}
            </div>
            <div>
              <div class="text-sm text-slate-400">{info.label}</div>
              <div class="font-semibold group-hover:text-primary-light transition-colors">{info.value}</div>
            </div>
            <svg class="w-4 h-4 ml-auto text-slate-500 group-hover:text-white group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        ))}
      </div>

      <!-- Contact form -->
      <form id="contact-form" class="glass-dark p-8 space-y-5">
        <h3 class="font-display text-xl font-semibold mb-6">Kirim Pesan</h3>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm text-slate-400 mb-2">Nama</label>
            <input
              type="text"
              id="name"
              required
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"
              placeholder="Nama Anda"
            />
          </div>
          <div>
            <label for="email" class="block text-sm text-slate-400 mb-2">Email</label>
            <input
              type="email"
              id="email"
              required
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"
              placeholder="email@example.com"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-sm text-slate-400 mb-2">Subjek</label>
          <input
            type="text"
            id="subject"
            required
            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"
            placeholder="Subjek pesan"
          />
        </div>

        <div>
          <label for="message" class="block text-sm text-slate-400 mb-2">Pesan</label>
          <textarea
            id="message"
            rows="4"
            required
            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all resize-none"
            placeholder="Tulis pesan Anda di sini..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="btn-glow w-full"
        >
          Kirim Pesan ✨
        </button>

        <!-- Success message -->
        <div id="success-msg" class="hidden text-center text-emerald-400 py-2">
          ✅ Pesan berhasil dikirim! Terima kasih.
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('success-msg');
  
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // Simulate form submission - replace with actual service (Formspree, etc)
    successMsg.classList.remove('hidden');
    form.reset();
    setTimeout(() => successMsg.classList.add('hidden'), 5000);
  });
</script>

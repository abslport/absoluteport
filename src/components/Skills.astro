---
const skillGroups = [
  {
    title: 'Store Operation',
    icon: 'store',
    color: 'indigo',
    skills: [
      { name: 'Inventory Management', level: 90 },
      { name: 'Operational Strategy', level: 85 },
      { name: 'Team Coordination', level: 88 },
      { name: 'Quality Control', level: 92 },
      { name: 'Sales Analytics', level: 82 }
    ]
  },
  {
    title: 'Service Advisor',
    icon: 'service',
    color: 'pink',
    skills: [
      { name: 'Customer Relations', level: 95 },
      { name: 'Service Consultation', level: 90 },
      { name: 'Problem Diagnosis', level: 88 },
      { name: 'Communication', level: 92 },
      { name: 'CRM Systems', level: 85 }
    ]
  },
  {
    title: 'Stamping Press',
    icon: 'press',
    color: 'cyan',
    skills: [
      { name: 'Machine Operation', level: 93 },
      { name: 'Maintenance & Repair', level: 85 },
      { name: 'Safety Compliance', level: 96 },
      { name: 'Process Optimization', level: 87 },
      { name: 'Quality Assurance', level: 90 }
    ]
  },
  {
    title: 'Tech Skills',
    icon: 'tech',
    color: 'purple',
    skills: [
      { name: 'HTML/CSS/JavaScript', level: 85 },
      { name: 'React & Vue.js', level: 75 },
      { name: 'Node.js', level: 70 },
      { name: 'Python', level: 65 },
      { name: 'SQL & Databases', level: 70 },
      { name: 'UI/UX Design', level: 80 }
    ]
  }
];

const colorMap = {
  indigo: { bg: 'bg-indigo-500/20', text: 'text-indigo-400', bar: 'from-indigo-500 to-indigo-300', border: 'hover:border-indigo-400/30' },
  pink: { bg: 'bg-pink-500/20', text: 'text-pink-400', bar: 'from-pink-500 to-pink-300', border: 'hover:border-pink-400/30' },
  cyan: { bg: 'bg-cyan-500/20', text: 'text-cyan-400', bar: 'from-cyan-500 to-cyan-300', border: 'hover:border-cyan-400/30' },
  purple: { bg: 'bg-purple-500/20', text: 'text-purple-400', bar: 'from-purple-500 to-purple-300', border: 'hover:border-purple-400/30' }
};
---

<section id="skills" class="relative py-32">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <p class="text-indigo-400 font-medium tracking-widest uppercase text-sm mb-4">Keahlian</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-4">
        <span class="gradient-text">Keahlian Saya</span>
      </h2>
      <p class="text-white/50 max-w-2xl mx-auto">Kombinasi unik antara keahlian operasional, layanan pelanggan, dan manufaktur yang didukung teknologi modern.</p>
    </div>

    <!-- Skills Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {skillGroups.map((group, index) => {
        const colors = colorMap[group.color];
        return (
          <div class={`glass-strong rounded-3xl p-8 hover-lift border border-white/5 ${colors.border} reveal`} style={`--reveal-delay: ${index * 0.15}s`}>
            <div class="flex items-center gap-4 mb-8">
              <div class={`w-12 h-12 rounded-2xl ${colors.bg} flex items-center justify-center ${colors.text}`}>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {group.icon === 'store' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>}
                  {group.icon === 'service' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>}
                  {group.icon === 'press' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>}
                  {group.icon === 'tech' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>}
                </svg>
              </div>
              <h3 class="font-display text-xl font-semibold">{group.title}</h3>
            </div>

            <div class="space-y-5">
              {group.skills.map(skill => (
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <span class="text-white/70 text-sm">{skill.name}</span>
                    <span class={`text-sm font-mono ${colors.text}`}>{skill.level}%</span>
                  </div>
                  <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                    <div class={`h-full rounded-full bg-gradient-to-r ${colors.bar} skill-bar`} data-level={skill.level}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Animate skill bars on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bars = entry.target.querySelectorAll('.skill-bar');
        bars.forEach(bar => {
          const level = bar.dataset.level;
          bar.style.width = '0%';
          setTimeout(() => {
            bar.style.transition = 'width 1s ease-out';
            bar.style.width = level + '%';
          }, 100);
        });
      }
    });
  }, { threshold: 0.2 });

  document.querySelectorAll('#skills .glass-strong').forEach(card => observer.observe(card));
</script>

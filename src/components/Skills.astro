---
// Skills section dengan filter & animasi
---

<section id="skills" class="py-20 md:py-28 bg-white/50 dark:bg-dark/50 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="section-title" data-reveal>Keahlian Saya</h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Store Operation -->
      <div data-reveal class="skill-card glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
          <span class="text-3xl">🏪</span>
          <span class="px-3 py-1 text-xs font-medium bg-indigo-500/10 text-indigo-500 rounded-full">Store Operation</span>
        </div>
        <h3 class="text-lg font-bold mb-3">Manajemen Operasional</h3>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
          <li>✓ SOP & Standarisasi Proses</li>
          <li>✓ Manajemen Inventori</li>
          <li>✓ Digitalisasi Operasional</li>
          <li>✓ Customer Service Excellence</li>
          <li>✓ Laporan & Analisis Operasional</li>
        </ul>
      </div>

      <!-- Service Advisor -->
      <div data-reveal-delay="100" class="skill-card glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
          <span class="text-3xl">🔧</span>
          <span class="px-3 py-1 text-xs font-medium bg-purple-500/10 text-purple-500 rounded-full">Service Advisor</span>
        </div>
        <h3 class="text-lg font-bold mb-3">Layanan Servis</h3>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
          <li>✓ Diagnosa Kendaraan</li>
          <li>✓ Perencanaan Maintenance</li>
          <li>✓ Konsultasi Teknis</li>
          <li>✓ Manajemen Estimasi Biaya</li>
          <li>✓ Komunikasi dengan Pelanggan</li>
        </ul>
      </div>

      <!-- Stamping Press -->
      <div data-reveal-delay="200" class="skill-card glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
          <span class="text-3xl">🏭</span>
          <span class="px-3 py-1 text-xs font-medium bg-cyan-500/10 text-cyan-500 rounded-full">Stamping Press</span>
        </div>
        <h3 class="text-lg font-bold mb-3">Operasi Mesin</h3>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
          <li>✓ Operasi Mesin Press</li>
          <li>✓ Quality Control Produk</li>
          <li>✓ Pemeliharaan Preventif</li>
          <li>✓ Keselamatan Kerja (K3)</li>
          <li>✓ Optimasi Proses Produksi</li>
        </ul>
      </div>

      <!-- Soft Skills -->
      <div data-reveal class="skill-card glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
          <span class="text-3xl">🤝</span>
          <span class="px-3 py-1 text-xs font-medium bg-green-500/10 text-green-500 rounded-full">Soft Skills</span>
        </div>
        <h3 class="text-lg font-bold mb-3">Kemampuan Personal</h3>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
          <li>✓ Komunikasi Efektif</li>
          <li>✓ Problem Solving</li>
          <li>✓ Team Collaboration</li>
          <li>✓ Time Management</li>
          <li>✓ Adaptabilitas Tinggi</li>
        </ul>
      </div>

      <!-- Tools -->
      <div data-reveal-delay="100" class="skill-card glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
          <span class="text-3xl">🛠️</span>
          <span class="px-3 py-1 text-xs font-medium bg-yellow-500/10 text-yellow-500 rounded-full">Tools</span>
        </div>
        <h3 class="text-lg font-bold mb-3">Peralatan</h3>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
          <li>✓ Mesin Press & Forming</li>
          <li>✓ Peralatan Diagnostik</li>
          <li>✓ Sistem Manajemen Inventori</li>
          <li>✓ Software Office Suite</li>
          <li>✓ Tools Analisis Data</li>
        </ul>
      </div>

      <!-- Technical -->
      <div data-reveal-delay="200" class="skill-card glass-card rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
          <span class="text-3xl">📊</span>
          <span class="px-3 py-1 text-xs font-medium bg-red-500/10 text-red-500 rounded-full">Analitik</span>
        </div>
        <h3 class="text-lg font-bold mb-3">Kemampuan Analitik</h3>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
          <li>✓ Analisis Data Operasional</li>
          <li>✓ Laporan Kinerja</li>
          <li>✓ Identifikasi Area Perbaikan</li>
          <li>✓ Cost Optimization</li>
          <li>✓ Risk Assessment</li>
        </ul>
      </div>
    </div>
  </div>
</section>

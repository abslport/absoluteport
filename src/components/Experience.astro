---
const experiences = [
  {
    role: 'Service Advisor',
    company: 'Automotive Service Center',
    period: '2022 - Sekarang',
    color: 'pink',
    icon: 'service',
    points: [
      'Konsultasi layanan kendaraan dan kebutuhan pelanggan',
      'Penjadwalan servis dan manajemen antrian',
      'Komunikasi efektif antara pelanggan dan tim teknis',
      'Meningkatkan kepuasan pelanggan hingga 95%'
    ]
  },
  {
    role: 'Stamping Press Operator',
    company: 'Manufacturing Industry',
    period: '2020 - 2022',
    color: 'cyan',
    icon: 'press',
    points: [
      'Mengoperasikan mesin stamping press dengan presisi tinggi',
      'Quality control dan inspeksi produk',
      'Perawatan preventif dan troubleshooting mesin',
      'Menjaga standar keselamatan kerja (K3)'
    ]
  },
  {
    role: 'Store Operation',
    company: 'Retail Business',
    period: '2019 - 2020',
    color: 'indigo',
    icon: 'store',
    points: [
      'Manajemen inventori dan stok barang',
      'Pengoptimalan layout dan visual merchandising',
      'Pelatihan dan koordinasi tim',
      'Analisis penjualan dan strategi operasional'
    ]
  }
];

const colorMap = {
  indigo: { border: 'border-indigo-500/30', dot: 'bg-indigo-500', glow: 'shadow-indigo-500/50' },
  pink: { border: 'border-pink-500/30', dot: 'bg-pink-500', glow: 'shadow-pink-500/50' },
  cyan: { border: 'border-cyan-500/30', dot: 'bg-cyan-500', glow: 'shadow-cyan-500/50' }
};
---

<section id="experience" class="relative py-32">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <p class="text-indigo-400 font-medium tracking-widest uppercase text-sm mb-4">Pengalaman</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-4">
        <span class="gradient-text">Perjalanan Karir</span>
      </h2>
      <p class="text-white/50 max-w-2xl mx-auto">Pengalaman yang beragam dan berharga dari berbagai industri.</p>
    </div>

    <!-- Timeline -->
    <div class="relative max-w-3xl mx-auto">
      <!-- Timeline Line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-indigo-500 via-pink-500 to-cyan-500 transform md:-translate-x-1/2"></div>

      {experiences.map((exp, index) => {
        const colors = colorMap[exp.color];
        const isLeft = index % 2 === 0;
        return (
          <div class={`relative mb-12 md:w-1/2 ${isLeft ? 'md:pr-12' : 'md:ml-auto md:pl-12'}`}>
            <!-- Timeline Dot -->
            <div class={`absolute top-6 left-4 md:left-auto ${isLeft ? 'md:-right-2' : 'md:-left-2'} transform -translate-x-1/2 md:translate-x-0`}>
              <div class={`w-4 h-4 rounded-full ${colors.dot} shadow-lg ${colors.glow}`}></div>
            </div>

            <!-- Card -->
            <div class="ml-12 md:ml-0 glass-strong rounded-3xl p-8 hover-lift border border-white/5 reveal">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs px-3 py-1 rounded-full bg-white/5 text-white/50 font-mono">{exp.period}</span>
                <span class={`w-8 h-8 rounded-xl bg-white/5 flex items-center justify-center`}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    {exp.icon === 'store' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>}
                    {exp.icon === 'service' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>}
                    {exp.icon === 'press' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>}
                  </svg>
                </span>
              </div>
              <h3 class="font-display text-2xl font-semibold mb-1">{exp.role}</h3>
              <p class="text-white/50 text-sm mb-4">{exp.company}</p>
              <ul class="space-y-3">
                {exp.points.map(point => (
                  <li class="flex items-start gap-3 text-white/60 text-sm">
                    <span class={`mt-1.5 w-1.5 h-1.5 rounded-full ${colors.dot} flex-shrink-0`}></span>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

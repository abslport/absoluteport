---
const experiences = [
  {
    role: 'Stamping Press Operator',
    company: 'Manufaktur Industry',
    period: '2022 - Sekarang',
    description: 'Mengoperasikan mesin press stamping dengan presisi tinggi, memastikan kualitas produk sesuai standar, dan menjaga keselamatan kerja.',
    achievements: [
      'Mencapai target produksi 98% setiap bulannya',
      'Mengurangi defect rate sebesar 25% melalui quality control yang ketat',
      'Dipercaya untuk training operator baru',
    ],
    icon: '⚙️',
  },
  {
    role: 'Service Advisor',
    company: 'Otomotif & Servis',
    period: '2020 - 2022',
    description: 'Menangani komunikasi dengan pelanggan, memberikan rekomendasi servis, dan mengelola jadwal pekerjaan bengkel.',
    achievements: [
      'Meningkatkan customer satisfaction score hingga 4.8/5',
      'Mengelola lebih dari 50 pelanggan per minggu',
      'Mengoptimalkan proses booking servis hingga 30% lebih efisien',
    ],
    icon: '🔧',
  },
  {
    role: 'Store Operation',
    company: 'Retail & Store Management',
    period: '2018 - 2020',
    description: 'Mengelola operasional store harian, inventory control, dan memastikan pengalaman belanja pelanggan terbaik.',
    achievements: [
      'Meningkatkan penjualan store sebesar 15% dalam satu tahun',
      'Mengelola inventory dengan akurasi 99%',
      'Memimpin tim store dengan 10+ anggota',
    ],
    icon: '🏪',
  },
];
---

<section id="experience" class="py-24 px-4">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="glass px-4 py-2 text-sm text-primary-light mb-4 inline-block">Pengalaman</span>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
        Jejak <span class="gradient-text">Karir Saya</span>
      </h2>
      <p class="text-slate-400 max-w-2xl mx-auto">Perjalanan profesional yang membentuk saya menjadi pribadi yang adaptif dan berdedikasi.</p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-primary to-accent opacity-30"></div>

      <div class="space-y-12">
        {experiences.map((exp, i) => (
          <div class={`relative flex flex-col md:flex-row gap-6 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Timeline dot -->
            <div class="absolute left-4 md:left-1/2 -translate-x-1/2 top-8 w-4 h-4 rounded-full bg-gradient-to-r from-primary to-accent shadow-lg shadow-primary/50"></div>

            <div class="md:w-1/2 ml-10 md:ml-0">
              <div class={`glass-dark p-8 card-hover ${i % 2 === 0 ? 'md:mr-6' : 'md:ml-6'}`}>
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center text-2xl">
                    {exp.icon}
                  </div>
                  <div>
                    <h3 class="font-display font-semibold text-lg">{exp.role}</h3>
                    <p class="text-sm text-primary-light">{exp.company}</p>
                  </div>
                </div>

                <div class="text-xs text-slate-400 mb-3">📅 {exp.period}</div>

                <p class="text-slate-400 text-sm leading-relaxed mb-4">{exp.description}</p>

                <ul class="space-y-2">
                  {exp.achievements.map(achv => (
                    <li class="flex items-start gap-2 text-sm text-slate-300">
                      <span class="text-emerald-400 mt-1 shrink-0">✓</span>
                      {achv}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
